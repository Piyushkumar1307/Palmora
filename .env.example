# This value is safe to expose to the mobile bundle. Use your machine's LAN IP
# rather than localhost when testing on a physical device.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3001

# Server-only configuration. Put these in server/.env (never prefix secrets with
# EXPO_PUBLIC_ and never commit the resulting file).
PORT=3001
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=ai-palm-reader

# Optional backend safeguards
CLIENT_ORIGINS=http://localhost:8081,http://localhost:19006
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
