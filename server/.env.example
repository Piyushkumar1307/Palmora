# Never commit your real credentials. Keep this file as a template only.
PORT=8787

# Comma-separated browser origins. Native React Native requests normally have no Origin header.
CLIENT_ORIGINS=http://localhost:8081,http://localhost:19006

# Server-side only: never place these values in the React Native app or an EXPO_PUBLIC_ variable.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Create these in your Cloudinary dashboard. Uploads are signed by this server.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=ai-palm-reader

# Upload and abuse controls.
MAX_UPLOAD_BYTES=8388608
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
